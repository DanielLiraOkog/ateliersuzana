{
  "name": "atelier-suzana-lira",
  "productName": "Atelier Suzana Lira",
  "version": "0.2.0",
  "description": "Gestão do Atelier Suzana Lira: produtos, materiais, pedidos e finanças",
  "main": "main.js",
  "author": "Atelier Suzana Lira",
  "scripts": {
    "start": "electron .",
    "dev": "node dev-server.js",
    "test": "node tests/calc.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.atelier.suzanalira",
    "productName": "Atelier Suzana Lira",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Atelier-Suzana-Lira-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "language": "1046",
      "artifactName": "Atelier-Suzana-Lira-Instalador-${version}.${ext}"
    },
    "extraFiles": [
      {
        "from": "build/COMO-ATUALIZAR.txt",
        "to": "COMO-ATUALIZAR.txt"
      }
    ]
  }
}
